<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Garbage Collection</title>
    <style>
        /* Grundlegende Styles */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #e6f2e6; /* helles Grün */
            color: #333;
        }

        header {
            background-color: #2e8b57; /* dunkleres Grün */
            color: white;
            padding: 20px;
            text-align: center;
        }

        nav {
            display: flex;
            justify-content: center;
            background-color: #3cb371; /* mittelgrün */
        }

        nav a {
            color: white;
            text-decoration: none;
            padding: 15px 25px;
            display: block;
        }

        nav a:hover {
            background-color: #2e8b57;
        }

        main {
            padding: 50px;
            text-align: center;
        }

        footer {
            background-color: #2e8b57;
            color: white;
            text-align: center;
            padding: 20px;
            position: fixed;
            width: 100%;
            bottom: 0;
        }

        .content-box {
            background-color: #f0fff0; /* noch helleres Grün */
            border: 2px solid #3cb371;
            padding: 30px;
            margin: 20px auto;
            width: 80%;
            border-radius: 10px;
        }

    </style>
</head>
<body>

    <header>
        <h1>Garbage Collection</h1>
        <p>Meine grüne Webseite / App</p>
    </header>

    <nav>
        <a href="#">Startseite</a>
        <a href="#">Über die App</a>
        <a href="#">Funktionen</a>
        <a href="#">Kontakt</a>
    </nav>

    <main>
        <div class="content-box">
            <h2>Willkommen bei Garbage Collection</h2>
            <p>Hier kommt später der Inhalt hin.</p>
        </div>
    </main>

    <footer>
        &copy; 2025 Garbage Collection
    </footer>

</body>
</html>
